{
  "name": "ttb-label-verifier",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:cfr": "node scripts/check-cfr-sync.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure": "node scripts/measure.mjs",
    "compare:fixtures": "node scripts/compare-fixtures.mjs",
    "copy:uswds": "node scripts/copy-uswds-assets.mjs",
    "predev": "npm run copy:uswds && npm run copy:samples",
    "prebuild": "npm run copy:uswds && npm run copy:samples",
    "copy:samples": "node scripts/copy-samples.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@trussworks/react-uswds": "^12.0.0",
    "@uswds/uswds": "^3.13.0",
    "focus-trap-react": "^11.0.6",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "sass": "^1.102.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
